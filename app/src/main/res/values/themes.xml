<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ToDoNote" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary color - 민트/청록색 -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorPrimaryVariant">@color/color_primary_light</item>
        
        <!-- Secondary color - 연한 살구색 -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary_dark</item>
        
        <!-- Background color - 옅은 크림색 -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/color_text_dark</item>
        <item name="android:textColorSecondary">@color/color_text_medium</item>
        <!-- 민트색 버튼 위 글자가 잘 보이도록 어두운 색을 쓴다 -->
        <item name="colorOnPrimary">@color/color_text_dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ToDoNote.MaterialAlertDialog</item>
        <item name="colorOnSecondary">@color/color_text_dark</item>
        <item name="colorOnBackground">@color/color_text_dark</item>
        <item name="colorOnSurface">@color/color_text_dark</item>
        <item name="colorOnSurfaceVariant">@color/color_text_medium</item>
        
        <!-- Accent color - 노란 연필색 -->
        <item name="colorAccent">@color/color_accent</item>
        
        <!-- Outline color -->
        <item name="colorOutline">@color/color_outline</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ToDoNote" parent="Base.Theme.ToDoNote" />

    <!-- 다이얼로그 버튼 글자를 밝은 민트색 대신 어두운 메인 컬러로 표시 -->
    <style name="ThemeOverlay.ToDoNote.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/color_primary_text</item>
    </style>

    <!-- 노트 편집 화면 상단의 아이콘 버튼 -->
    <style name="NoteEditIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/color_text_dark</item>
    </style>
</resources>
