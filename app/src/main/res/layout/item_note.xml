<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="4dp">

    <!-- 내용 영역 (MaterialCardView로 테두리 추가) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/color_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_primary_light">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:padding="8dp">

            <!-- 노트 내용 (하얀색 배경) -->
            <TextView
                android:id="@+id/tv_note_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="top|start"
                android:maxLines="7"
                android:padding="8dp"
                android:textColor="@color/color_text_dark"
                android:textSize="12sp" />

            <!-- 잠금 아이콘 (가운데 정렬, 작게) -->
            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_lock"
                android:visibility="gone"
                android:contentDescription="잠금" />

            <!-- 고정 표시 -->
            <ImageView
                android:id="@+id/iv_note_pin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:contentDescription="고정됨"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                app:tint="@color/color_primary_text" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 노트 제목 (CardView 밖, 별도로 분리, 배경 없음) -->
    <TextView
        android:id="@+id/tv_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/color_text_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
